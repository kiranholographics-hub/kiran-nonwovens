# ── Kiran Nonwovens site ─────────────────────────────────────────────────
# Copy to .env.local and fill in. Never commit .env.local.

# Where the Express API lives. Server-side only — the browser never sees it;
# the enquiry form posts to this app's own /api/enquiries, which forwards on.
# Leave blank to run the site entirely off the local fallback catalogue.
API_BASE_URL=http://localhost:4100

# Canonical public origin, used for metadata, sitemap.xml and robots.txt.
# PLACEHOLDER — the real domain is still pending from Sir.
NEXT_PUBLIC_SITE_URL=http://localhost:3100
