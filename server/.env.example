# ── Kiran Nonwovens API ──────────────────────────────────────────────────
# Copy to .env and fill in. Never commit .env.

# Port. Kept off 3000/4000 so this can run alongside the existing
# kiran-global-exports-v2 frontend (3000) and backend (4000).
PORT=4100

# MongoDB connection string (Atlas or local).
# Use a SEPARATE database from the towels/linen site.
MONGODB_URI=mongodb://127.0.0.1:27017/kiran-nonwovens

# Comma-separated origins allowed to call this API.
CORS_ORIGIN=http://localhost:3100

# ── Enquiry notification email (Nodemailer) ──────────────────────────────
# Leave SMTP_HOST blank to disable outbound mail — enquiries are still
# saved to MongoDB, the API just skips the notification.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Where enquiry notifications are sent, and who they appear to come from.
ENQUIRY_TO=
ENQUIRY_FROM=
