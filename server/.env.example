# ── Kiran Nonwovens API ──────────────────────────────────────────────────
# Copy to .env and fill in. Never commit .env.

# Port. Kept off 3000/4000 so this can run alongside the existing
# kiran-global-exports-v2 frontend (3000) and backend (4000).
PORT=4100

# MongoDB connection string (Atlas or local).
# Use a SEPARATE database from the towels/linen site.
MONGODB_URI=mongodb://127.0.0.1:27017/kiran-nonwovens

# Comma-separated origins allowed to call this API.
CORS_ORIGIN=http://localhost:3100

# ── Enquiry notification email (Nodemailer) ──────────────────────────────
# Leave SMTP_HOST blank to disable outbound mail — enquiries are still
# saved to MongoDB, the API just skips the notification.
#
# Gmail recipe (works with kirannonwovens@gmail.com):
#   1. Google Account → Security → turn on 2-Step Verification.
#   2. Google Account → Security → App passwords → create one (16 letters).
#   3. SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_SECURE=false
#      SMTP_USER=<the gmail address>  SMTP_PASS=<the 16-letter app password,
#      no spaces>  ENQUIRY_TO=<where enquiries should arrive; several addresses
#      can be separated by commas>
#   4. Run `npm run mail:test` to confirm.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Where enquiry notifications are sent, and who they appear to come from.
ENQUIRY_TO=
ENQUIRY_FROM=

# ── Rate limits (optional — these are the defaults) ─────────────────────
# Enquiries per visitor IP per window. Keeps a script from filling the
# database and the export team's inbox.
# RATE_ENQUIRY_MAX=5
# RATE_ENQUIRY_WINDOW_MS=900000
# RATE_API_MAX=240
