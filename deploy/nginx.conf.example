# Nginx for a VPS that serves BOTH the website and the API.
# Replace example.com, copy to /etc/nginx/sites-available/kiran-nonwovens,
# link it into sites-enabled, then:  sudo nginx -t && sudo systemctl reload nginx
# Add https afterwards with:  sudo certbot --nginx -d example.com -d www.example.com -d api.example.com

# ── The website (the contents of client/dist) ───────────────────────────
server {
    listen 80;
    server_name example.com www.example.com;
    root /var/www/kiran-nonwovens/dist;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain application/xml;

    # Every page is pre-built as <route>/index.html, so serve that directly.
    # Anything else is a real 404 (the site's own 404 page, marked noindex).
    location / {
        try_files $uri $uri/index.html =404;
    }
    error_page 404 /404.html;

    # Hashed files never change, so browsers may keep them for a year.
    location ~* \.(js|css|woff2?|svg|png|jpe?g|webp|avif)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
    # Videos are replaced in place, so cache them for a month, not forever.
    location ~* \.(mp4|webm)$ {
        expires 30d;
        add_header Cache-Control "public";
    }
    # Pages and the manifest must always be re-checked.
    location ~* \.(html|webmanifest)$ {
        add_header Cache-Control "public, max-age=0, must-revalidate";
    }

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
}

# ── The API (Node, run by PM2 on port 4100) ─────────────────────────────
server {
    listen 80;
    server_name api.example.com;

    location / {
        proxy_pass http://127.0.0.1:4100;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # The API rate-limits by visitor address, so it must see the real one.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
