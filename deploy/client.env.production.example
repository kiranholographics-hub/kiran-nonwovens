# Save as  client/.env.production  (this file is NOT secret — it only holds
# public addresses). `npm run build` reads it automatically and it overrides
# the localhost values in client/.env.
#
# Then build with:   node scripts/predeploy.mjs && npm run build

# The live address of the website. https, no trailing slash.
#
# Must be the SAME hostname that client/public/.htaccess redirects to —
# for this site that is the bare one, without "www". predeploy checks it.
VITE_SITE_URL=https://kirannonwovens.com

# The live address of the API (the Node server). https.
VITE_API_URL=https://api.kirannonwovens.com

# Fill in AFTER launch, from Google Search Console / Bing Webmaster Tools:
VITE_GSC_VERIFICATION=
VITE_BING_VERIFICATION=

# For a STAGING copy only (keeps it out of Google). Never on the real launch:
# VITE_NOINDEX=true
