# The same keys as server/.env, with LIVE values. On Render/Railway you enter
# these as "Environment Variables" instead of a file. Never commit real values.

NODE_ENV=production
PORT=4100

# Same Atlas cluster, its own database. Must end in /kiran-nonwovens (or any
# name containing "nonwoven") — never the towels/linen site's database.
MONGODB_URI=mongodb://USER:PASSWORD@HOST:27017/kiran-nonwovens?ssl=true&...

# The website's address(es), exactly as typed in the browser. Comma-separate
# if both www and non-www are used. NOT localhost.
CORS_ORIGIN=https://www.example.com,https://example.com

# Enquiry email (Gmail app password — see server/.env.example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=kirannonwovens@gmail.com
SMTP_PASS=
ENQUIRY_TO=kirannonwovens@gmail.com
ENQUIRY_FROM=
