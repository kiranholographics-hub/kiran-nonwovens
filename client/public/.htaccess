# Kiran Nonwovens — Apache / Hostinger
#
# The build prerenders a real HTML page per route at <route>/index.html. Serve
# that file for a clean URL, so crawlers and first loads get the page's own
# markup, title and description rather than the home page's.
#
# URLs with no prerendered page get the 404 page with a real 404 status.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ── One site, one origin ────────────────────────────────────────────
  # Send everything to https and to the bare hostname, so Google sees one
  # site rather than http/https x www/non-www. kirannonwovens.com is the
  # Search Console property and the host every canonical tag names.
  #
  # The X-Forwarded-Proto check matters on shared hosting: when TLS is
  # terminated at a proxy in front of Apache, %{HTTPS} reads "off" even on an
  # https request, and a redirect to https would then loop forever.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://kirannonwovens.com%{REQUEST_URI} [L,R=301]

  RewriteCond %{HTTP_HOST} !^kirannonwovens\.com$ [NC]
  RewriteRule ^ https://kirannonwovens.com%{REQUEST_URI} [L,R=301]

  # ── One address per page ────────────────────────────────────────────
  # Every page lives at a directory (/guides/x/index.html), and Apache's
  # default is to 301 a directory URL to its trailing-slash form. That sent
  # every clean URL away from the exact address the canonical tag, the
  # sitemap and every internal link use, so the whole sitemap redirected and
  # each canonical pointed at a redirect. Serve the clean URL directly, and
  # send the trailing-slash form to it instead.
  DirectorySlash Off

  # /guides/x/  ->  /guides/x   (301, so the duplicate drops out of the index)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.+)/$ /$1 [L,R=301]

  # Never rewrite a request for a file that exists (assets, sitemap, robots).
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # /products  ->  /products/index.html, when that page was prerendered.
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*?)/?$ /$1/index.html [L]

  # The admin panel is a single-page app: /hq and /hq/... all load the shell.
  RewriteRule ^hq(/.*)?$ /index.html [L]

  # Anything else is a real 404: the prerendered 404.html (ErrorDocument below)
  # is served with an HTTP 404 status, so it is not a soft 404.
  RewriteRule ^ - [R=404,L]
</IfModule>

# Compress text assets (HTML, CSS, JS, JSON, SVG, XML) on the way out.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/ld+json application/xml image/svg+xml
  AddOutputFilterByType DEFLATE application/manifest+json
</IfModule>

<IfModule mod_headers.c>
  # ── Security headers ────────────────────────────────────────────────
  # Safe on a static site: nothing here is framed, sniffed or given camera,
  # microphone or location access it doesn't use.
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  # Once the domain is live on https, uncomment to make browsers insist on it.
  # (Only after you have confirmed https works for the whole site.)
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Hashed asset filenames change on every build, so they can cache hard.
  <FilesMatch "\.(js|css|woff2?|svg|png|jpe?g|webp|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Videos are not hashed (you drop a new file in over the old one), so cache
  # them for a month rather than forever. Range requests let them start playing
  # before they finish downloading.
  <FilesMatch "\.(mp4|webm)$">
    Header set Cache-Control "public, max-age=2592000"
    Header set Accept-Ranges "bytes"
  </FilesMatch>
  # HTML must not be cached hard, or a deploy leaves stale pages behind.
  <FilesMatch "\.(html|webmanifest)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType video/mp4 .mp4
  AddType video/webm .webm
  AddType application/manifest+json .webmanifest
</IfModule>

ErrorDocument 404 /404.html
