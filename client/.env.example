# ── Kiran Nonwovens client ───────────────────────────────────────────────
# Copy to .env.local and fill in. Never commit .env.local.
#
# Vite bakes VITE_* values into the bundle at build time, so a production
# build must be made with the real values set.

# Where the Express API lives. Leave blank to run the site entirely off the
# local fallback catalogue in src/data/catalog.js.
VITE_API_URL=http://localhost:4100

# Canonical public origin — used for canonical tags, og:url and sitemap.xml.
# PLACEHOLDER — the real domain is still pending from Sir.
VITE_SITE_URL=http://localhost:3100
